# Copie para .env e substitua os valores de exemplo. Nunca versione o .env.

# MySQL
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_NAME=y3d
DB_USER=y3d_user
DB_PASSWORD=troque-esta-senha-do-banco

# API e acesso administrativo
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_SECONDS=7200
ADMIN_EMAILS=admin@example.com

# Porta publicada pelo Nginx
HTTP_PORT=80

# Links e envio de e-mail (SMTP)
Y3D_BASE_URL=http://localhost
Y3D_EMAIL_FROM=loja@example.com
Y3D_SMTP_HOST=smtp.gmail.com
Y3D_SMTP_PORT=587
Y3D_SMTP_ENCRYPTION=tls
Y3D_SMTP_USER=usuario@example.com
Y3D_SMTP_PASSWORD=troque-pela-senha-de-aplicativo
