# Copie este arquivo para .env (cp .env.example .env) e troque os valores.
# O arquivo .env NUNCA deve ser commitado nem lido por agentes de IA.

HTTP_PORT=80

DB_ROOT_PASSWORD=troque-esta-senha-root
DB_NAME=y3d
DB_USER=y3d_user
DB_PASSWORD=troque-esta-senha

# Gere um segredo longo, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_SECONDS=7200

# E-mails (separados por vírgula) que são administradores: veem o painel admin e todos os pedidos.
# Cadastre-se no site com um desses e-mails e faça login.
ADMIN_EMAILS=admin@exemplo.com

# URL pública da loja PHP. Deixe vazia para detectar pela requisição atual.
Y3D_BASE_URL=
# Gmail SMTP (use uma senha de app do Google, não a senha normal da conta).
Y3D_EMAIL_FROM=y3dsuporte@gmail.com
Y3D_SMTP_HOST=smtp.gmail.com
Y3D_SMTP_PORT=587
Y3D_SMTP_ENCRYPTION=tls
Y3D_SMTP_USER=y3dsuporte@gmail.com
Y3D_SMTP_PASSWORD=

# Asaas Pix (use a chave da API do ambiente escolhido e um token exclusivo para o webhook).
Y3D_ASAAS_API_KEY=
Y3D_ASAAS_WEBHOOK_TOKEN=
Y3D_ASAAS_API_URL=https://api-sandbox.asaas.com/v3
