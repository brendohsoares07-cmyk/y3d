# Copie para .env (cp .env.example .env). O .env nunca deve ser commitado.

# Porta da API (em desenvolvimento o site abre em http://localhost:8080, mas a API abre em http://localhost:3001). Padrão: 3001
PORT=3001

# Segredo que assina os cookies de sessão. Obrigatório em produção: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Pasta dos arquivos JSON (contas, pedidos, mensagens...). Padrão: ./data
# Y3D_DATA_DIR=/var/www/data

# E-mails (separados por vírgula) que viram administradores ao fazer login.
# Cadastre-se no site com um desses e-mails e depois entre pelo login.
ADMIN_EMAILS=admi123@gmail.com

# E-mail (contato e recuperação de senha). Para Gmail use uma "senha de app" do Google.
Y3D_EMAIL_FROM=
Y3D_SMTP_HOST=smtp.gmail.com
Y3D_SMTP_PORT=587
Y3D_SMTP_ENCRYPTION=tls
Y3D_SMTP_USER=
Y3D_SMTP_PASSWORD=
# Endereço público do site (links do e-mail de recuperação). Pode ficar vazio para detectar sozinho.
Y3D_BASE_URL=

# Porta da loja no Docker (docker-compose.loja.yml). Padrão: 8080
# LOJA_PORT=8080
